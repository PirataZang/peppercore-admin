# URL base da API do backend (usada por src/services/api.js)
# Em desenvolvimento, deixe vazio para usar o proxy do Vite (/api -> http://backend:8000)
# Em produção sob subpath nginx, use o mesmo path do frontend (ex: /peppercore-admin)
# URL completa também funciona (ex: https://api.seudominio.com)
VITE_API_URL=

# Path base dos assets + router (Vite `base` / import.meta.env.BASE_URL)
# Em desenvolvimento, deixe vazio (= '/')
# Em produção sob nginx em /peppercore-admin/, defina /peppercore-admin
# Tem prioridade sobre VITE_API_URL na hora de resolver o `base`.
VITE_BASE_PATH=