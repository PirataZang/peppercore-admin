# Project general configs
PROJECT_NAME=peppercore_admin

# Service Ports (host mapping)
FRONTEND_PORT=5174
BACKEND_PORT=8001
DB_PORT_EXTERNAL=5437
DB_PORT=5432
REDIS_PORT_EXTERNAL=6380

# Backend / Laravel General configs
APP_ENV=local
APP_DEBUG=true

# Database PostgreSQL settings
DB_DATABASE=peppercore_admin
DB_USER=peppercore
DB_PASSWORD=peppercore_igor
DB_HOST=postgres

# Redis settings
REDIS_PASSWORD=redis123
REDIS_HOST=redis
REDIS_PORT=6379

# Frontend Vite variables
# Em produção, o nginx serve o frontend em /peppercore-admin/ e faz proxy de /peppercore-admin/api para o backend
# Em desenvolvimento, o Vite proxy cuida de /api -> http://backend:8000
# Deixe vazio para usar URLs relativas (funciona tanto em dev quanto em prod com nginx proxy)
VITE_API_URL=/peppercore-admin
