# Project general configs
PROJECT_NAME=peppercore_admin

# Service Ports (host mapping)
FRONTEND_PORT=5174
BACKEND_PORT=8001
DB_PORT_EXTERNAL=5437
DB_PORT=5432
REDIS_PORT_EXTERNAL=6380

# Backend / Laravel General configs
APP_ENV=local
APP_DEBUG=true

# Database PostgreSQL settings
DB_DATABASE=peppercore_admin
DB_USER=peppercore
DB_PASSWORD=secret123
DB_HOST=postgres

# Redis settings
REDIS_PASSWORD=redis123
REDIS_HOST=redis
REDIS_PORT=6379

# Frontend Vite variables
# Em desenvolvimento, deixe vazio para usar o proxy do Vite (/api -> http://backend:8000)
# Em produção, defina o path base onde o nginx serve o frontend (ex: /peppercore-admin)
# O nginx deve fazer proxy de /peppercore-admin/api para o backend
VITE_API_URL=
