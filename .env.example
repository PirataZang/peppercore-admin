# Project general configs
PROJECT_NAME=peppercore_admin

# Service Ports (host mapping)
FRONTEND_PORT=5174
BACKEND_PORT=8001
DB_PORT_EXTERNAL=5437
DB_PORT=5432
REDIS_PORT_EXTERNAL=6380

# Backend / Laravel General configs
APP_ENV=local
APP_DEBUG=true

# Database PostgreSQL settings
DB_DATABASE=peppercore_admin
DB_USER=peppercore
DB_PASSWORD=secret123
DB_HOST=postgres

# Redis settings
REDIS_PASSWORD=redis123
REDIS_HOST=redis
REDIS_PORT=6379

# Frontend Vite variables
# VITE_API_URL: prefixo usado por src/services/api.js para montar /api/...
#   - dev (proxy do Vite): deixe vazio -> chama /api/... (proxy -> http://backend:8000)
#   - prod sob nginx em /peppercore-admin/: /peppercore-admin -> chama /peppercore-admin/api/...
#   - backend em domínio separado: https://api.seudominio.com
# VITE_BASE_PATH: Vite `base` (assets + import.meta.env.BASE_URL do router)
#   - dev: vazio (= '/')
#   - prod sob nginx em /peppercore-admin/: /peppercore-admin
#   - se vazio, o vite.config cai para VITE_API_URL quando for um path.
VITE_API_URL=
VITE_BASE_PATH=
